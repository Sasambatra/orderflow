# Native tests require an EXISTING isolated PostgreSQL database with this suffix.
# For Docker use `make test-docker`: service URLs and secrets are injected there.
APP_ENV=test
DATABASE_URL=postgresql+psycopg://orderflow:GENERATE_DB_PASSWORD@127.0.0.1:5434/orderflow_test
TEST_DATABASE_URL=postgresql+psycopg://orderflow:GENERATE_DB_PASSWORD@127.0.0.1:5434/orderflow_test
TEST_REDIS_URL=redis://127.0.0.1:6380/15
JWT_SECRET=GENERATE_JWT_SECRET
WEBHOOK_SECRET=GENERATE_WEBHOOK_SECRET
RATE_LIMIT_ENABLED=false
